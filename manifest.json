{
  "manifest_version": 3,
  "name": "TheFork Restaurant Scraper",
  "version": "1.0",
  "description": "Extracts restaurant information from TheFork website",
  "permissions": ["activeTab", "scripting", "cookies"],
  "host_permissions": ["<all_urls>", "*://*.thefork.fr/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
